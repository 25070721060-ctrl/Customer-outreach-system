# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git.

# --- Google Custom Search (for finding companies/people via Google) ---
# Create at: https://programmablesearchengine.google.com/  +  https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Hunter.io (for finding/verifying emails at a company domain) ---
# Free tier available at: https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Outgoing email (SMTP) ---
# If using Gmail: enable 2FA, then create an "App Password" (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_NAME=Your Name
